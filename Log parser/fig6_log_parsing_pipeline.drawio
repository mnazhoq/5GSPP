<mxCell id="r1why" value="MongoDB driver internal log. source=&quot;infra&quot;, not &quot;5gnf&quot;.&#xa;Excluded from all correlation rules.&#xa;Would create spurious &quot;Write to Files&quot; node if kept." style="text;html=1;align=left;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" vertex="1" parent="1"><mxGeometry x="660" y="82" width="620" height="52" as="geometry"/></mxCell>
