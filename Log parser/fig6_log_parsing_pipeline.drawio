<mxCell id="r5dec" value="PRECISION FIX&#xa;ms-precision&#xa;added to K8s rows" style="text;html=1;align=center;fontStyle=1;fontSize=12;fillColor=#185FA5;fontColor=#ffffff;strokeColor=#0C447C;rounded=1;" vertex="1" parent="1"><mxGeometry x="420" y="348" width="200" height="52" as="geometry"/></mxCell>
<mxCell id="r5why" value="K8s Event API timestamps are millisecond-precise.&#xa;E3a: T03:52:32.104Z  pod_created  (txn_id=free5gc-upf-0)&#xa;E3b: T03:52:32.891Z  container_started  (txn_id=free5gc-upf-0)&#xa;Deterministic ordering preserved for Union-Find." style="text;html=1;align=left;fontFamily=Courier New;fontSize=11;fillColor=#dae8fc;strokeColor=#185FA5;rounded=1;" vertex="1" parent="1"><mxGeometry x="660" y="348" width="620" height="52" as="geometry"/></mxCell>
<!-- ROW 6: SHA256 field dropped -->
<mxCell id="r6raw" value="… RSA SHA256:1M4RzhMyWuFS:/&gt; …&#xa;(SSH key fingerprint field)" style="text;html=1;align=left;fontFamily=Courier New;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="412" width="360" height="42" as="geometry"/></mxCell>
<mxCell id="r6dec" value="FIELD DROPPED&#xa;no correlation value" style="text;html=1;align=center;fontStyle=1;fontSize=12;fillColor=#b85450;fontColor=#ffffff;strokeColor=#A32D2D;rounded=1;" vertex="1" parent="1"><mxGeometry x="420" y="412" width="200" height="42" as="geometry"/></mxCell>
<mxCell id="r6why" value="SSH key fingerprint is identity metadata, not an entity or action.&#xa;No IP, no SUPI, no pod name, no session key derived from it.&#xa;Stored in raw field only. Not propagated to CEF actor/target." style="text;html=1;align=left;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" vertex="1" parent="1"><mxGeometry x="660" y="412" width="620" height="42" as="geometry"/></mxCell>
