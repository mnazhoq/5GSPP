<mxCell id="r4why" value="source=5gnf  actor=SMF  target=UPF  severity=2&#xa;action=pfcp_session_release  txn_id=smf-pfcp-003&#xa;&quot;Query to SMF&quot; was wrong: SMF initiates this toward UPF.&#xa;Correct name: &quot;SMF releases UPF session&quot;" style="text;html=1;align=left;fontFamily=Courier New;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1"><mxGeometry x="660" y="284" width="620" height="52" as="geometry"/></mxCell>
