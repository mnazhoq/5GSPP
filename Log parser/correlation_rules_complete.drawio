<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="21.0.0" type="device">
  <diagram name="7 Correlation Rules — 5G SOC" id="7rules-5g-soc">
    <mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <!-- ══════════ TITLE BANNER ══════════ -->
        <mxCell id="title" value="Multi-Source Log Correlation: 7 Rule Families for 5G SOC" style="text;html=1;align=center;fontStyle=1;fontSize=18;fillColor=#1e4d78;fontColor=#ffffff;strokeColor=none;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1960" height="40" as="geometry"/>
        </mxCell>

        <!-- ══════════ R1: TEMPORAL WINDOW ══════════ -->
        <mxCell id="r1_bg" value="" style="rounded=1;fillColor=#E6F1FB;strokeColor=#185FA5;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="560" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="r1_hdr" value="R1 — Temporal Window" style="text;html=1;align=left;fontStyle=1;fontSize=13;fillColor=#185FA5;fontColor=#ffffff;strokeColor=none;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="350" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="r1_ref" value="DeepLog [CCS'17] · LogAnomaly [IJCAI'19]" style="text;html=1;align=right;fontStyle=2;fontSize=10;fillColor=none;strokeColor=none;fontColor=#185FA5;" vertex="1" parent="1">
          <mxGeometry x="370" y="60" width="210" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="r1_formula" value="conf = max(0,  1 − |t_A − t_B| / W )" style="text;html=1;align=left;fontFamily=Courier New;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="94" width="540" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="r1_params" value="Default W = 60 s,  stride S = 30 s.  Returns 0 when gap &gt; W." style="text;html=1;align=left;fontSize=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="540" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="r1_ex_ok" value="Example (FIRES):  NRF log T03:57 + SMF log T03:58 → gap = 74s ≈ W → conf = 0.88" style="text;html=1;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="144" width="540" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="r1_ex_fail" value="Example (DOES NOT FIRE):  sshd T03:11 + NRF T03:57 → gap = 2760s ≫ W → conf = 0  ← R5 handles this" style="text;html=1;align=left;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="168" width="540" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="r1_reviewer" value="Reviewer fix: R1 was incorrectly cited as the rule linking the 46-min gap. It is NOT. See R5." style="text;html=1;align=left;fontSize=9;fontColor=#A32D2D;fillColor=#fff0f0;strokeColor=#A32D2D;strokeWidth=1.5;dashed=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="192" width="540" height="18" as="geometry"/>
        </mxCell>

        <!-- ══════════ R2: ENTITY IDENTITY ══════════ -->
        <mxCell id="r2_bg" value="" style="rounded=1;fillColor=#E6F1FB;strokeColor=#185FA5;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="600" y="60" width="560" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="r2_hdr" value="R2 — Entity Identity  (shared IP / SUPI / pod)" style="text;html=1;align=left;fontStyle=1;fontSize=13;fillColor=#185FA5;fontColor=#ffffff;strokeColor=none;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="60" width="380" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="r2_ref" value="HOLMES [S&amp;P'19] · NoDoze [NDSS'19]" style="text;html=1;align=right;fontStyle=2;fontSize=10;fillColor=none;strokeColor=none;fontColor=#185FA5;" vertex="1" parent="1">
          <mxGeometry x="980" y="60" width="180" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="r2_formula" value="conf = |entities(A) ∩ entities(B)| / |entities(A) ∪ entities(B)|   (Jaccard)" style="text;html=1;align=left;fontFamily=Courier New;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="94" width="540" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="r2_params" value="entities(e) = {actor, target} ∪ regex_IPs(message).  No time constraint." style="text;html=1;align=left;fontSize=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="610" y="120" width="540" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="r2_ex_ok" value="Example (FIRES):  SMF log actor=10.96.1.11  +  NetFlow src_ip=10.96.1.11 → Jaccard=1.0" style="text;html=1;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="144" width="540" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="r2_ex2" value="Example (FIRES):  NRF log component=NRF  +  K8s pod=free5gc-nrf-0 (same NF) → Jaccard=0.5" style="text;html=1;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="168" width="540" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="r2_note" value="Cross-source: links NF logs to NetFlow and K8s using shared IP or NF name as anchor." style="text;html=1;align=left;fontSize=9;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="192" width="540" height="18" as="geometry"/>
        </mxCell>

        <!-- ══════════ R3: SESSION KEY ══════════ -->
        <mxCell id="r3_bg" value="" style="rounded=1;fillColor=#FFF8E6;strokeColor=#BA7517;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1180" y="60" width="800" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="r3_hdr" value="R3 — Session / Context Key  (user + src_ip + host within session TTL)" style="text;html=1;align=left;fontStyle=1;fontSize=13;fillColor=#BA7517;fontColor=#ffffff;strokeColor=none;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="60" width="540" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="r3_ref" value="OmegaLog [NDSS'20] · MCI [NDSS'18] · SLEUTH [USENIX'17]" style="text;html=1;align=right;fontStyle=2;fontSize=10;fillColor=none;strokeColor=none;fontColor=#BA7517;" vertex="1" parent="1">
          <mxGeometry x="1720" y="60" width="260" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="r3_formula" value="conf = 1.0  if  key(A) = key(B) ≠ None  AND  |t_A − t_B| ≤ TTL (default 3600 s)" style="text;html=1;align=left;fontFamily=Courier New;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="94" width="780" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="r3_keys" value="Key extraction:  syslog → (username, src_ip, hostname)  |  free5GC NF → SUPI  |  K8s → (pod, namespace)" style="text;html=1;align=left;fontSize=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1190" y="120" width="780" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="r3_ex1" value="Example (FIRES — same session):  sshd T03:11 key=(vagrant,10.0.2.2,k8s-master)  +  sshd T03:40 key=(vagrant,10.0.2.2,k8s-master)  gap=29 min &lt; TTL" style="text;html=1;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="144" width="780" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="r3_reviewer" value="Reviewer fix:  The two syslog lines (T03:11 auth + T03:40 session open) share session_key (vagrant/10.0.2.2). R3 links them. The 46-min INTER-SOURCE gap (sshd→NRF) is handled by R5, not R3." style="text;html=1;align=left;fontSize=9;fontColor=#7D4E00;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="168" width="780" height="30" as="geometry"/>
        </mxCell>

        <!-- ══════════ R4: TRANSACTION ID ══════════ -->
        <mxCell id="r4_bg" value="" style="rounded=1;fillColor=#F0EEFE;strokeColor=#534AB7;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="280" width="560" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="r4_hdr" value="R4 — NF Transaction ID / SUPI Chain" style="text;html=1;align=left;fontStyle=1;fontSize=13;fillColor=#534AB7;fontColor=#ffffff;strokeColor=none;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="280" width="340" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="r4_ref" value="HOLMES [S&amp;P'19] · TPG [S&amp;P'20] · UNICORN [NDSS'20]" style="text;html=1;align=right;fontStyle=2;fontSize=10;fillColor=none;strokeColor=none;fontColor=#534AB7;" vertex="1" parent="1">
          <mxGeometry x="360" y="280" width="220" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="r4_formula" value="conf = 1.0  if  A.txn_id = B.txn_id ≠ None   (exact match, no time constraint)" style="text;html=1;align=left;fontFamily=Courier New;fontSize=11;fillColor=#e8e4fe;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="314" width="540" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="r4_params" value="txn_id extracted from free5GC log field or 3GPP SUPI string.  Zero time constraint." style="text;html=1;align=left;fontSize=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="340" width="540" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="r4_ex1" value="Example (FIRES):  SMF PFCP Deletion (txn=smf-001)  +  UDM AuthConfirm (txn=smf-001) → conf=1.0" style="text;html=1;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="362" width="540" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="r4_ex2" value="Example (FIRES):  SMF Setup Association (txn=smf-001)  +  NG Setup (txn=amf-001) linked via SUPI" style="text;html=1;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="386" width="540" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="r4_note" value="Most reliable rule within free5GC: transaction IDs are injected by the NF itself, no regex needed." style="text;html=1;align=left;fontSize=9;fillColor=#e8e4fe;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="410" width="540" height="18" as="geometry"/>
        </mxCell>

        <!-- ══════════ R5: CAUSAL DAG (KEY RULE) ══════════ -->
        <mxCell id="r5_bg" value="" style="rounded=1;fillColor=#F0EEFE;strokeColor=#3C3489;strokeWidth=3;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="600" y="280" width="760" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="r5_hdr" value="R5 — Causal Dependency  (3GPP Procedure DAG)  ← RESOLVES THE 46-MIN GAP" style="text;html=1;align=left;fontStyle=1;fontSize=13;fillColor=#3C3489;fontColor=#ffffff;strokeColor=none;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="280" width="760" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="r5_ref" value="HOLMES [S&amp;P'19] · MPI [USENIX'17] · ATLAS [USENIX'21] · SLEUTH [USENIX'17]" style="text;html=1;align=right;fontStyle=2;fontSize=10;fillColor=none;strokeColor=none;fontColor=#3C3489;" vertex="1" parent="1">
          <mxGeometry x="600" y="308" width="760" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="r5_formula" value="conf = 1.0  if  B.event_type ∈ Succ(A.event_type)  AND  t_A &lt; t_B   (no gap limit)" style="text;html=1;align=left;fontFamily=Courier New;fontSize=11;fillColor=#e8e4fe;strokeColor=#3C3489;strokeWidth=1.5;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="330" width="740" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="r5_dag" value="3GPP DAG:  ssh_auth → {nf_register, k8s_pod_created}  |  nf_register → {udm_auth, pfcp_create}&#xa;           pfcp_create → {ng_setup, pfcp_release, netflow}  |  k8s_container_started → {nf_register}" style="text;html=1;align=left;fontFamily=Courier New;fontSize=9;fillColor=#f5f0ff;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="356" width="740" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="r5_ex_KEY" value="★ KEY EXAMPLE:  sshd ssh_auth (T03:11)  →  NRF nf_register (T03:57)    gap = 46 min   R5 = 1.0    R1 = 0.0" style="text;html=1;align=left;fontSize=10;fontStyle=1;fillColor=#f8cecc;strokeColor=#A32D2D;strokeWidth=2;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="394" width="740" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="r5_reason" value="Rationale: admin SSHs into k8s host → provisions free5GC NF → NRF registers NF profile. Causal order is known from 3GPP TS 23.502. Gap is irrelevant." style="text;html=1;align=left;fontSize=9;fontColor=#3C3489;fillColor=#e8e4fe;strokeColor=#534AB7;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="420" width="740" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="r5_reviewer" value="Reviewer answer: The 46-min gap is intentional. Rule R5 (causal DAG) provides the linking justification, not R1 (time window). The paper must state this explicitly." style="text;html=1;align=left;fontSize=9;fontColor=#A32D2D;fillColor=#fff0f0;strokeColor=#A32D2D;strokeWidth=1.5;dashed=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="452" width="740" height="24" as="geometry"/>
        </mxCell>

        <!-- ══════════ R6: SEMANTIC SIMILARITY ══════════ -->
        <mxCell id="r6_bg" value="" style="rounded=1;fillColor=#FFF0EC;strokeColor=#993C1D;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="500" width="560" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="r6_hdr" value="R6 — Semantic Similarity  (TF-IDF cosine)" style="text;html=1;align=left;fontStyle=1;fontSize=13;fillColor=#993C1D;fontColor=#ffffff;strokeColor=none;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="500" width="340" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="r6_ref" value="LogAnomaly [IJCAI'19] · LogRobust [FSE'19] · Logs2Graphs ['23]" style="text;html=1;align=right;fontStyle=2;fontSize=10;fillColor=none;strokeColor=none;fontColor=#993C1D;" vertex="1" parent="1">
          <mxGeometry x="360" y="500" width="220" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="r6_formula" value="conf = max(0,  cosine( tfidf(A.msg), tfidf(B.msg) ))" style="text;html=1;align=left;fontFamily=Courier New;fontSize=11;fillColor=#fce9e4;strokeColor=#D85A30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="534" width="540" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="r6_params" value="Corpus fitted on all events at startup.  Fallback for vendor-proprietary log formats." style="text;html=1;align=left;fontSize=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="560" width="540" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="r6_ex1" value="Example (FIRES):  'PFCP Session Deletion' + 'PFCP Session Setup' → cosine ≈ 0.72 → conf = 0.72" style="text;html=1;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="582" width="540" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="r6_note" value="Use when NF vendor format differs from free5GC. Default weight w₆=0.05 (low; structural rules preferred)." style="text;html=1;align=left;fontSize=9;fillColor=#fce9e4;strokeColor=#D85A30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="606" width="540" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="r6_compat" value="Compatibility: handles format drift and unstructured logs automatically — directly addresses reviewer Issue 2." style="text;html=1;align=left;fontSize=9;fontColor=#A32D2D;fillColor=#fff0f0;strokeColor=#A32D2D;strokeWidth=1.5;dashed=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="628" width="540" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="r6_compat2" value="Also: the CEF normalisation step (Algorithm 2) ensures compatibility before any rule is applied." style="text;html=1;align=left;fontSize=9;fontColor=#A32D2D;fillColor=#fff0f0;strokeColor=#A32D2D;strokeWidth=1;dashed=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="650" width="540" height="18" as="geometry"/>
        </mxCell>

        <!-- ══════════ R7: STATISTICAL CO-OCCURRENCE ══════════ -->
        <mxCell id="r7_bg" value="" style="rounded=1;fillColor=#FFF0EC;strokeColor=#993C1D;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="600" y="500" width="560" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="r7_hdr" value="R7 — Statistical Co-occurrence  (Apriori lift)" style="text;html=1;align=left;fontStyle=1;fontSize=13;fillColor=#993C1D;fontColor=#ffffff;strokeColor=none;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="500" width="340" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="r7_ref" value="HERCULE [ACSAC'16] · AIQL [ATC'18] · SAQL [USENIX'18]" style="text;html=1;align=right;fontStyle=2;fontSize=10;fillColor=none;strokeColor=none;fontColor=#993C1D;" vertex="1" parent="1">
          <mxGeometry x="940" y="500" width="220" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="r7_formula" value="lift(A,B) = P(A,B)/(P(A)·P(B))    conf = clip((lift−1)/Λ, 0, 1)    Λ=2" style="text;html=1;align=left;fontFamily=Courier New;fontSize=11;fillColor=#fce9e4;strokeColor=#D85A30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="534" width="540" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="r7_params" value="Requires training corpus of labelled windows.  Set w₇ = 0 without training data." style="text;html=1;align=left;fontSize=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="610" y="560" width="540" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="r7_ex1" value="Example:  CrashLoopBackOff (K8s) co-occurs with AuthFailure (NF) in 89% of attack windows → lift=6.3 → conf=1.0" style="text;html=1;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="582" width="540" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="r7_note" value="Learned from historical SOC incident reports.  Detects anomalous event-type pairs not in causal DAG." style="text;html=1;align=left;fontSize=9;fillColor=#fce9e4;strokeColor=#D85A30;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="606" width="540" height="18" as="geometry"/>
        </mxCell>

        <!-- ══════════ COMBINATOR ══════════ -->
        <mxCell id="comb_bg" value="" style="rounded=1;fillColor=#EAF3DE;strokeColor=#3B6D11;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1200" y="280" width="780" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="comb_hdr" value="Generalised Combinator — Weighted Sum + Union-Find" style="text;html=1;align=left;fontStyle=1;fontSize=13;fillColor=#3B6D11;fontColor=#ffffff;strokeColor=none;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="280" width="780" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="comb_formula" value="score(A,B) = Σ w_i · R_i(A,B)    correlated iff score(A,B) ≥ θ (default θ=0.20)" style="text;html=1;align=left;fontFamily=Courier New;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1210" y="314" width="760" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="comb_w" value="Default weights:   R1=0.10  R2=0.18  R3=0.22  R4=0.25  R5=0.20  R6=0.05  R7=0.00" style="text;html=1;align=left;fontFamily=Courier New;fontSize=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1210" y="342" width="760" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="comb_closure" value="Transitive closure via Union-Find (near-linear):  if corr(A,B) and corr(B,C) then A,B,C are one group." style="text;html=1;align=left;fontSize=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1210" y="364" width="760" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="comb_learn" value="Optional: learn w_i via logistic regression on labelled pairs (5-fold CV).  See Algorithm 3." style="text;html=1;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1210" y="386" width="760" height="18" as="geometry"/>
        </mxCell>
