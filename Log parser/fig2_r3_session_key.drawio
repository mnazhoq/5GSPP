<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="21.0.0">
<diagram name="R3 Session Key" id="r3-session">
<mxGraphModel dx="1400" dy="800" grid="0" pageWidth="1100" pageHeight="560">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="hdr" value="R3 — Session Key Correlation  |  Running Example: operator SSH session → NF provisioning" style="text;html=1;align=center;fontStyle=1;fontSize=15;fillColor=#854F0B;fontColor=#ffffff;strokeColor=none;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1060" height="32" as="geometry"/></mxCell>
<mxCell id="formula" value="conf = 1.0  if  key(A) = key(B) ≠ None  AND  |t_A − t_B| ≤ TTL (3600 s)     [OmegaLog, NDSS'20  ·  MCI, NDSS'18]" style="text;html=1;align=center;fontFamily=Courier New;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1060" height="24" as="geometry"/></mxCell>
<!-- E1 raw log -->
<mxCell id="e1raw" value="Event E1 — syslog (T03:11:12Z)&#xa;auth.info k8s-core-master&#xa;sshd: Accepted publickey for vagrant&#xa;from 10.0.2.2 port 36094" style="text;html=1;align=left;fontFamily=Courier New;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="340" height="76" as="geometry"/></mxCell>
<!-- E2 raw log -->
<mxCell id="e2raw" value="Event E2 — syslog (T03:40:31Z)&#xa;auth.info k8s-core-master&#xa;sshd: session opened for user vagrant&#xa;from 10.0.2.2" style="text;html=1;align=left;fontFamily=Courier New;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;rounded=1;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="380" height="76" as="geometry"/></mxCell>
<!-- gap -->
<mxCell id="gap" value="29 min 19 s gap" style="text;html=1;align=center;fontStyle=1;fontSize=13;fontColor=#A32D2D;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="400" y="118" width="260" height="22" as="geometry"/></mxCell>
<!-- Extractor arrows -->
<mxCell id="arr1" value="extract session_key" style="text;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;fontColor=#854F0B;" edge="1" parent="1" source="e1raw" target="key1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="arr2" value="extract session_key" style="text;html=1;edgeStyle=orthogonalEdgeStyle;fontSize=10;fontColor=#854F0B;" edge="1" parent="1" source="e2raw" target="key2"><mxGeometry relative="1" as="geometry"/></mxCell>
<!-- key boxes -->
<mxCell id="key1" value="key(E1) = (&quot;vagrant&quot;, &quot;10.0.2.2&quot;, &quot;k8s-core-master&quot;)" style="text;html=1;align=center;fontFamily=Courier New;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="216" width="460" height="32" as="geometry"/></mxCell>
<mxCell id="key2" value="key(E2) = (&quot;vagrant&quot;, &quot;10.0.2.2&quot;, &quot;k8s-core-master&quot;)" style="text;html=1;align=center;fontFamily=Courier New;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;rounded=1;" vertex="1" parent="1"><mxGeometry x="560" y="216" width="520" height="32" as="geometry"/></mxCell>
<!-- match -->
<mxCell id="match" value="KEY MATCH  =&gt;  key(E1) = key(E2)" style="text;html=1;align=center;fontStyle=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#3B6D11;strokeWidth=2;rounded=1;" vertex="1" parent="1"><mxGeometry x="280" y="268" width="540" height="32" as="geometry"/></mxCell>
<!-- TTL check -->
<mxCell id="ttl" value="|T03:40:31 − T03:11:12| = 1759 s  ≤  TTL = 3600 s  ✓  within session TTL" style="text;html=1;align=center;fontFamily=Courier New;fontSize=11;fillColor=#f5f5f5;strokeColor=#aaa;rounded=1;" vertex="1" parent="1"><mxGeometry x="200" y="316" width="700" height="26" as="geometry"/></mxCell>
<!-- result -->
<mxCell id="result" value="R3(E1, E2) = 1.0     Event: &quot;Access server&quot;     (E1=publickey auth,  E2=session open)" style="text;html=1;align=center;fontStyle=1;fontSize=13;fillColor=#1e4d78;fontColor=#ffffff;strokeColor=none;rounded=1;" vertex="1" parent="1"><mxGeometry x="100" y="360" width="900" height="36" as="geometry"/></mxCell>
<!-- extractor pseudo-code -->
<mxCell id="extractor" value="Key extractor (syslog):&#xa;  username  ←  regex [for|user]\s+(\w+)  →  &quot;vagrant&quot;&#xa;  src_ip    ←  regex \d{1,3}(\.\d{1,3}){3}  →  &quot;10.0.2.2&quot;&#xa;  host      ←  HOSTNAME field  →  &quot;k8s-core-master&quot;" style="text;html=1;align=left;fontFamily=Courier New;fontSize=11;fillColor=#f5f5f5;strokeColor=#aaa;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="540" height="80" as="geometry"/></mxCell>
<!-- important note -->
<mxCell id="note" value="Important: R3 links E1+E2 (two syslog lines, same session).&#xa;The further link E2→E4 (NRF, 46-min gap) uses R5 (causal DAG), not R3.&#xa;R3 key for NRF = None (no syslog session in NF logs)." style="text;html=1;align=left;fontSize=11;fontColor=#A32D2D;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;rounded=1;" vertex="1" parent="1"><mxGeometry x="580" y="410" width="500" height="80" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
