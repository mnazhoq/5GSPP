          <mxGeometry x="30" y="470" width="460" height="16" as="geometry"/>
        </mxCell>

        <!-- Correlation rules -->
        <mxCell id="p1b_rules_hdr" value="Correlation rules — how events from different sources are linked" style="text;html=1;align=center;fontStyle=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="30" y="494" width="460" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="p1b_rule1" value="Rule 1 — Time window (W=60 s):  events from ANY source within same sliding window are candidates for correlation." style="text;html=1;align=left;fontSize=9;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="514" width="460" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="p1b_rule2" value="Rule 2 — Session key (no time limit, bounded by session TTL):  events sharing the same session_key are part of one logical session regardless of timestamp gap. This is why the T03:11:12Z (auth) and T03:40:31Z (session open) syslog lines — both with user=vagrant, src_ip=10.0.2.2 — map to the single event 'Access server'." style="text;html=1;align=left;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="540" width="460" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="p1b_rule3" value="Rule 3 — NF transaction ID / SUPI:  free5GC events sharing a transaction_id or SUPI are linked regardless of component (SMF, UPF, AMF)." style="text;html=1;align=left;fontSize=9;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="596" width="460" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="p1b_code" value="Source code / pseudocode for all three rules must be provided in the paper (or public repository) to satisfy the reviewer's replicability requirement." style="text;html=1;align=left;fontSize=9;fontColor=#6d3600;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="630" width="460" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="p1b_algo" value="Algorithm (pseudocode):&#xa;for each event e in sorted(all_logs):&#xa;    cef = parse_to_CEF(e)          # source-specific parser&#xa;    key = extract_session_key(cef)  # Rule 2&#xa;    window = get_window(cef.ts)     # Rule 1&#xa;    if key in open_sessions:&#xa;        open_sessions[key].add(cef) # session chain&#xa;    elif any event in window shares key:&#xa;        open_sessions[key] = [cef]  # new session&#xa;    else:&#xa;        windows[window].add(cef)    # time-window only" style="text;html=1;align=left;fontFamily=Courier New;fontSize=8;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="656" width="460" height="26" as="geometry"/>
        </mxCell>

        <!-- ① → ①b arrow -->
