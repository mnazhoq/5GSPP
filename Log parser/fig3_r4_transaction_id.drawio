<!-- source note -->
<mxCell id="srcnote" value="txn_id extraction:  free5GC logs embed transaction_id in structured fields.  Syslog: no txn_id → R4=0.  K8s: pod name used as proxy.  NetFlow: correlation via R2 (shared IP)." style="text;html=1;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#aaa;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="382" width="1060" height="30" as="geometry"/></mxCell>
<mxCell id="strength" value="R4 is the strongest rule for free5GC logs: exact field match, no regex, no time dependency, no false positives from timestamp proximity." style="text;html=1;align=left;fontSize=11;fontColor=#534AB7;fontStyle=1;fillColor=#E8E4FE;strokeColor=#534AB7;strokeWidth=1.5;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="424" width="1060" height="26" as="geometry"/></mxCell>
